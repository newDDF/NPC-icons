---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

const dataPath = path.join(process.cwd(), "public/data/icon-details.json");

export function getStaticPaths() {
  const dataPath = path.join(process.cwd(), "public/data/icon-details.json");
  const icons = JSON.parse(fs.readFileSync(dataPath, "utf8"));
  const seenRoutes = new Set();

  return icons.flatMap((icon) => {
    const legacyIds = Array.isArray(icon.legacyIds)
      ? icon.legacyIds
      : (icon.legacyId ? [icon.legacyId] : []);
    const paths = [];

    for (const routeId of [icon.id, ...legacyIds]) {
      if (!routeId || seenRoutes.has(routeId)) continue;
      seenRoutes.add(routeId);
      paths.push({ params: { id: routeId }, props: { icon } });
    }

    return paths;
  });
}

const { icon } = Astro.props;
const canonical = `https://icons.x0u0x.xyz/icons/${encodeURIComponent(icon.id)}/`;
const isRetired = icon.status === "retired";
const title = isRetired
  ? `${icon.name} Icon — Retired | NPC-icons`
  : `${icon.name} Icon — Free ${icon.format.toUpperCase()} Download | NPC-icons`;
const description = isRetired
  ? `The ${icon.name} icon has been retired and is no longer available for download.`
  : `Explore the ${icon.name} icon. View its details, categories and source, and download the free ${icon.format.toUpperCase()} asset from NPC-icons.`;
const stats = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/data/stats.json"), "utf8"));
const displayColor = icon.color && icon.color !== "none" ? icon.color : "";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  includeMainScript={false}
>
  <div class="detail-site-shell">
    <Header svgTotal={stats.svg} pngTotal={stats.png} />
    <main class="icon-detail-page">
      <article class="detail-workspace">
        <section class="workspace-preview-panel" aria-label="Icon preview">
          <div class="workspace-panel-heading">
            <span class="workspace-eyebrow">ICON WORKSPACE</span>
            <span class="workspace-format">{icon.format.toUpperCase()}</span>
          </div>

          <nav class="workspace-tabs" aria-label="Icon workspace navigation">
            <button type="button" class="workspace-tab" data-workspace-tab="details" aria-pressed="false">
              <span class="workspace-tab-icon" aria-hidden="true">i</span>
              <span>Details</span>
            </button>
            <button type="button" class="workspace-tab is-active" data-workspace-tab="customize" aria-pressed="true">
              <span class="workspace-tab-icon" aria-hidden="true">✳</span>
              <span>Customize</span>
            </button>
            <a class="workspace-tab workspace-library-link" href="/" aria-label="Return to icon library">
              <span class="workspace-tab-icon" aria-hidden="true">▦</span>
              <span>Icon Library</span>
            </a>
          </nav>

          <div class="detail-preview">
            {isRetired ? (
              <p role="status">
                This icon has been retired and is no longer available for download.
              </p>
            ) : (
              <img src={icon.path} alt={`${icon.name} icon`} width="180" height="180" />
            )}
          </div>

          <h1>{icon.name}</h1>
          <p class="detail-subtitle">Preview your icon and explore its details.</p>

          {icon.category?.length > 0 && (
            <div class="detail-categories">
              {icon.category.map((category) => <span class="detail-category">{category}</span>)}
            </div>
          )}

          <div class="workspace-preview-note">
            <span class="workspace-status-dot"></span>
            <span>Original asset preview</span>
          </div>
        </section>

        <section class="workspace-editor-panel" aria-label="Icon details and customization">
          <div class="workspace-editor-heading">
            <div>
              <span class="workspace-eyebrow">EDITOR</span>
              <h2>Workspace</h2>
            </div>
            <span class="workspace-editor-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.64 5.64l2.12 2.12m8.48 8.48 2.12 2.12m0-12.72-2.12 2.12m-8.48 8.48-2.12 2.12"/><circle cx="12" cy="12" r="4"/></svg>
            </span>
          </div>

          <p class="workspace-editor-intro" data-workspace-view="customize">Adjust appearance. Your original asset remains unchanged.</p>

          {!isRetired && (
            <div
              class="workspace-section editor-controls"
              data-workspace-view="customize"
              data-icon-path={icon.path}
              data-icon-name={icon.name}
              data-icon-filename={icon.filename}
              data-icon-format={icon.format.toLowerCase()}
              data-icon-color={displayColor || ""}
            >
              <h3>Appearance</h3>

              <div class="editor-control-group">
                <div class="editor-control-label">
                  <label for="editor-size">Preview size</label>
                  <output for="editor-size" data-size-output>180 px</output>
                </div>
                <input id="editor-size" data-editor-control="size" type="range" min="64" max="320" step="8" value="180" />
              </div>

              <div class="editor-control-group">
                <span class="editor-control-title">Preview background</span>
                <div class="editor-choice-row" role="group" aria-label="Preview background">
                  <button type="button" class="editor-choice is-active" data-editor-bg="transparent" aria-pressed="true">Transparent</button>
                  <button type="button" class="editor-choice" data-editor-bg="light" aria-pressed="false">Light</button>
                  <button type="button" class="editor-choice" data-editor-bg="dark" aria-pressed="false">Dark</button>
                </div>
              </div>

              {icon.format.toLowerCase() === "svg" && (
                <div class="editor-control-group">
                  <div class="editor-palette" data-editor-palette aria-label="SVG color palette"></div>
                  <p class="editor-help" data-editor-palette-status>Analyzing SVG colors…</p>
                </div>
              )}
            </div>
          )}

          <div class="workspace-section" data-workspace-view="details">
            <h3>Icon information</h3>
            <div class="detail-information">
              <div class="detail-row">
                <span>Format</span>
                <strong>{icon.format.toUpperCase()}</strong>
              </div>

              {displayColor && (
                <div class="detail-row">
                  <span>Original color</span>
                  <strong class="detail-color">
                    <span class="detail-color-swatch" style={`background:${displayColor}`}></span>
                    {displayColor}
                  </strong>
                </div>
              )}

              <div class="detail-row">
                <span>Filename</span>
                <strong>{icon.filename}</strong>
              </div>

              <div class="detail-description">
                <h3>About this icon</h3>
                <p>{icon.info || "No additional information is available."}</p>
              </div>

              <div class="detail-row">
                <span>By</span>
                <strong>{icon.by || "Not provided"}</strong>
              </div>

              <div class="detail-row">
                <span>Origin</span>
                <strong>{({
                  official: "Official",
                  repository: "Icon repository",
                  traced: "Traced",
                  original: "Original",
                  other: "Other"
                })[icon.origin] || "Not provided"}</strong>
              </div>

              <div class="detail-row">
                <span>Source</span>
                {icon.source ? (
                  <a href={icon.source} target="_blank" rel="noopener noreferrer">Official Website ↗</a>
                ) : (
                  <span class="detail-muted">Not provided</span>
                )}
              </div>
            </div>
          </div>

          <div class="workspace-section workspace-export-section" data-workspace-view="customize">
            <h3>Export</h3>
            <p>Choose a format and download.</p>
            {!isRetired && (
              <div class="detail-actions editor-export-actions">
                <a class="detail-primary" href={icon.path} download={icon.filename}>Original {icon.format.toUpperCase()}</a>
                <button type="button" class="detail-secondary" data-editor-export="png">Export PNG</button>
                <button type="button" class="detail-secondary" data-editor-export="webp">Export WebP</button>
                {icon.format.toLowerCase() === "svg" && (
                  <button type="button" class="detail-secondary" data-editor-export="svg">Customized SVG</button>
                )}
              </div>
            )}
            <p class="editor-status" data-editor-status role="status" aria-live="polite"></p>
          </div>
        </section>
      </article>
    </main>
    <footer class="detail-footer">
      <div class="detail-footer-links">
        <a href="https://github.com/newDDF/NPC-icons/blob/main/DISCLAIMER.md" target="_blank" rel="noopener noreferrer">Disclaimer</a>
        <a href="https://github.com/newDDF/NPC-icons" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:newnpcx2@proton.me">Email</a>
      </div>
      <p>Copyright © 2026 NPC-icons</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .icon-detail-page {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 18px 0 36px;
    color: var(--text-color);
  }

  .detail-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    gap: 20px;
  }

  .workspace-preview-panel,
  .workspace-editor-panel {
    min-width: 0;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    background: var(--blur-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    box-shadow: var(--shadow);
  }

  .workspace-preview-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .workspace-panel-heading,
  .workspace-editor-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  .workspace-eyebrow {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .workspace-format {
    padding: 6px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .detail-preview {
    display: grid;
    place-items: center;
    width: min(100%, 380px);
    aspect-ratio: 1;
    margin: auto 0 28px;
    border: 1px solid var(--glass-border);
    border-radius: 26px;
    background-color: var(--card-bg);
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--text-muted) 7%, transparent) 25%, transparent 25%),
      linear-gradient(-45deg, color-mix(in srgb, var(--text-muted) 7%, transparent) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--text-muted) 7%, transparent) 75%),
      linear-gradient(-45deg, transparent 75%, color-mix(in srgb, var(--text-muted) 7%, transparent) 75%);
    background-size: 24px 24px;
    background-position: 0 0, 0 12px, 12px -12px, -12px 0;
  }

  .detail-preview img {
    display: block;
    width: 58%;
    height: 58%;
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
  }

  .workspace-preview-panel h1 {
    max-width: 100%;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .detail-subtitle {
    margin: 10px 0 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .detail-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .detail-category {
    padding: 5px 11px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--text-color);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .workspace-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 20px 0 24px;
  }

  .workspace-tab {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: var(--blur-bg);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .workspace-tab:hover {
    border-color: var(--accent-color);
    color: var(--text-color);
  }

  .workspace-tab.is-active {
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent-color) 10%, var(--blur-bg));
    color: var(--accent-color);
  }

  .workspace-tab-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1px solid currentColor;
    border-radius: 6px;
    font-size: 0.72rem;
    line-height: 1;
  }

  [data-workspace-view][hidden] {
    display: none !important;
  }

  .workspace-preview-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .workspace-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-color);
  }

  .workspace-editor-panel {
    text-align: left;
  }

  .workspace-editor-heading {
    margin-bottom: 12px;
  }

  .workspace-editor-heading h2 {
    margin: 6px 0 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
  }

  .workspace-editor-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: var(--card-bg);
    color: var(--accent-color);
  }

  .workspace-editor-mark svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .workspace-editor-intro {
    margin: 0 0 28px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Appearance editor */
  .editor-controls {
    display: grid;
    gap: 26px;
    padding-bottom: 26px;
  }

  .editor-controls > h3 {
    margin: 0 0 -8px;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .editor-control-group {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .editor-control-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .editor-control-label output {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .editor-control-title {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .editor-controls input[type="range"] {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    accent-color: var(--accent-color);
    cursor: pointer;
  }

  /* Background selector */
  .editor-choice-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .editor-choice {
    display: inline-flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--blur-bg);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .editor-choice:hover,
  .editor-choice:focus-visible {
    border-color: var(--accent-color);
    color: var(--text-color);
  }

  .editor-choice.is-active {
    border-color: color-mix(in srgb, var(--accent-color) 55%, var(--glass-border));
    background: color-mix(in srgb, var(--accent-color) 9%, var(--blur-bg));
    color: var(--accent-color);
  }

  /* Keep export buttons consistent with their existing appearance */
  .detail-secondary {
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--card-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .detail-secondary:hover {
    border-color: var(--accent-color);
  }

  /* Unified SVG color controls — no nested outer card */
  .editor-control-group:has([data-editor-palette]) {
    gap: 13px;
    padding-top: 22px;
    border-top: 1px solid var(--glass-border);
  }

  .editor-control-group:has([data-editor-palette]) > .editor-control-label {
    align-items: center;
  }

  .editor-color-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .editor-color-row input[type="color"] {
    display: block;
    width: 48px;
    height: 44px;
    padding: 4px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--card-bg);
    cursor: pointer;
  }

  .editor-color-row input[type="text"] {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 13px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--blur-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  .editor-text-button {
    padding: 5px 0 5px 10px;
    border: 0;
    background: transparent;
    color: var(--accent-color);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .editor-text-button:hover {
    opacity: 0.75;
  }

  .editor-help,
  .editor-status {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .editor-status:not(:empty) {
    margin-top: 12px;
  }

  /* Compact SVG color palette */
  .editor-palette {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  :global(.editor-palette-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28px, 1fr));
    gap: 9px;
    max-height: 144px;
    overflow-y: auto;
    padding: 2px 2px 6px;
    overscroll-behavior: contain;
  }

  :global(.editor-palette-swatch) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: var(--blur-bg);
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease;
  }

  :global(.editor-palette-swatch span) {
    display: block;
    width: 23px;
    height: 23px;
    border: 1px solid rgb(127 127 127 / 18%);
    border-radius: 50%;
  }

  :global(.editor-palette-swatch:hover) {
    transform: scale(1.08);
  }

  :global(.editor-palette-swatch[aria-pressed="true"]) {
    border: 2px solid var(--accent-color);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-color) 13%, transparent);
  }

  :global(.editor-palette-editor) {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    padding: 12px;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--blur-bg) 82%, transparent);
    backdrop-filter: blur(12px) saturate(125%);
    -webkit-backdrop-filter: blur(12px) saturate(125%);
  }

  :global(.editor-palette-editor[hidden]) {
    display: none !important;
  }

  :global(.editor-palette-editor input[type="color"]) {
    width: 42px;
    height: 42px;
    padding: 3px;
    border: 1px solid var(--glass-border);
    border-radius: 11px;
    background: var(--card-bg);
    cursor: pointer;
  }

  :global(.editor-palette-hex) {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--glass-border);
    border-radius: 9px;
    background: var(--card-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  :global(.editor-palette-opacity) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 12px;
    padding-top: 10px;
    border-top: 1px solid var(--glass-border);
  }

  :global(.editor-palette-opacity label) {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  :global(.editor-palette-opacity output) {
    color: var(--text-color);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.editor-palette-opacity input[type="range"]) {
    grid-column: 1 / -1;
    width: 100%;
    height: 18px;
    margin: 0;
    accent-color: var(--accent-color);
    cursor: pointer;
  }

  [data-editor-palette-status] {
    padding-top: 0;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  @media (max-width: 560px) {
    .editor-controls {
      gap: 22px;
    }

    .editor-choice-row {
      gap: 6px;
    }

    .editor-choice {
      min-height: 40px;
      padding: 7px 5px;
      font-size: 0.76rem;
    }

    .editor-control-group:has([data-editor-palette]) {
      padding-top: 18px;
    }



    :global(.editor-palette-hex) {
      grid-column: 1 / -1;
      height: 40px;
    }

