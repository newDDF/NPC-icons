---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

const dataPath = path.join(process.cwd(), "public/api/icons.json");

export function getStaticPaths() {
  const dataPath = path.join(process.cwd(), "public/api/icons.json");
  const icons = JSON.parse(fs.readFileSync(dataPath, "utf8"));

  return icons.map((icon) => ({
    params: { id: icon.id },
    props: { icon }
  }));
}

const { icon } = Astro.props;
const canonical = `https://icons.x0u0x.xyz/icons/${encodeURIComponent(icon.id)}/`;
const title = `${icon.name} Icon — Free ${icon.format.toUpperCase()} Download | NPC-icons`;
const description = `Explore the ${icon.name} icon. View its details, categories and source, and download the free ${icon.format.toUpperCase()} asset from NPC-icons.`;
const stats = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/data/stats.json"), "utf8"));
const displayColor = icon.color && icon.color !== "none" ? icon.color : "";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  includeMainScript={false}
>
  <div class="detail-site-shell">
    <Header svgTotal={stats.svg} pngTotal={stats.png} />
    <main class="icon-detail-page">
    <nav class="detail-breadcrumb" aria-label="Back to icon library">
      <a class="detail-back-link" href="/">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5m7 7-7-7 7-7" />
        </svg>
        <span>All icons</span>
      </a>
    </nav>

    <article class="detail-card">
      <div class="detail-preview">
        <img src={icon.path} alt={`${icon.name} icon`} width="180" height="180" />
      </div>

      <h1>{icon.name}</h1>
      <p class="detail-subtitle">Icon details and downloads</p>

      {icon.category?.length > 0 && (
        <div class="detail-categories">
          {icon.category.map((category) => <span class="detail-category">{category}</span>)}
        </div>
      )}

      <div class="detail-information">
        <div class="detail-row">
          <span>Format</span>
          <strong>{icon.format.toUpperCase()}</strong>
        </div>

        {displayColor && (
          <div class="detail-row">
            <span>Color</span>
            <strong class="detail-color">
              <span class="detail-color-swatch" style={`background:${displayColor}`}></span>
              {displayColor}
            </strong>
          </div>
        )}

        <div class="detail-row">
          <span>Filename</span>
          <strong>{icon.filename}</strong>
        </div>

        <div class="detail-description">
          <h2>About this icon</h2>
          <p>{icon.info || "No additional information is available."}</p>
        </div>

        <div class="detail-row">
          <span>Source</span>
          {icon.source ? (
            <a href={icon.source} target="_blank" rel="noopener noreferrer">Official Website ↗</a>
          ) : (
            <span class="detail-muted">Not provided</span>
          )}
        </div>
      </div>

      <div class="detail-actions">
        <a class="detail-primary" href={icon.path} download={icon.filename}>Download {icon.format.toUpperCase()}</a>
        <a class="detail-secondary" href="/">Back to icon library</a>
      </div>
    </article>

    </main>
    <footer class="detail-footer">
      <div class="detail-footer-links">
        <a href="https://github.com/newDDF/NPC-icons/blob/main/DISCLAIMER.md" target="_blank" rel="noopener noreferrer">Disclaimer</a>
        <a href="https://github.com/newDDF/NPC-icons" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="mailto:newnpcx2@proton.me">Email</a>
      </div>
      <p>Copyright © 2026 NPC-icons</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .icon-detail-page {
    width: min(760px, calc(100% - 32px));
    margin: 0 auto;
    padding: 8px 0 24px;
    color: var(--text-color);
  }

  .detail-breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 2px 0 16px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .detail-breadcrumb a,
  .detail-information a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .detail-breadcrumb a:hover,
  .detail-information a:hover {
    text-decoration: underline;
  }

  .detail-card {
    padding: clamp(22px, 5vw, 42px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    background: var(--blur-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    box-shadow: var(--shadow);
    text-align: center;
  }

  .detail-preview {
    display: grid;
    place-items: center;
    width: 220px;
    height: 220px;
    max-width: 100%;
    margin: 0 auto 18px;
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    background: var(--card-bg);
  }

  .detail-preview img {
    display: block;
    width: 180px;
    height: 180px;
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
  }

  .detail-card h1 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.7rem, 5vw, 2.4rem);
  }

  .detail-subtitle {
    margin: 8px 0 18px;
    color: var(--text-muted);
  }

  .detail-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
  }

  .detail-category {
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--accent-color);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .detail-information {
    text-align: left;
    border-top: 1px solid var(--glass-border);
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 15px 0;
    border-bottom: 1px solid var(--glass-border);
    font-size: 0.92rem;
  }

  .detail-row > span:first-child {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .detail-row strong {
    overflow-wrap: anywhere;
    text-align: right;
  }

  .detail-color {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .detail-color-swatch {
    width: 15px;
    height: 15px;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
  }

  .detail-muted {
    color: var(--text-muted);
  }

  .detail-description {
    padding: 20px 0;
    border-bottom: 1px solid var(--glass-border);
  }

  .detail-description h2 {
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .detail-description p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .detail-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .detail-actions a:hover {
    transform: translateY(-2px);
    opacity: 0.88;
  }

  .detail-primary {
    background: var(--accent-color);
    border-color: transparent !important;
    color: #fff;
  }

  .detail-secondary {
    color: var(--text-color);
    background: var(--card-bg);
  }

  .detail-footer {
    margin-top: 12px;
    padding: 18px 20px 20px;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    text-align: center;
    font-size: 0.8rem;
  }

  .detail-footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-bottom: 8px;
  }

  .detail-footer-links a {
    color: var(--text-color);
    text-decoration: none;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .detail-footer-links a:hover {
    opacity: 1;
    color: var(--accent-color);
  }

  .detail-footer p {
    margin: 0;
  }

  .detail-site-shell :global(.brand-header) {
    padding-top: 24px;
    padding-bottom: 12px;
  }

  @media (max-width: 480px) {
    .detail-preview {
      width: 180px;
      height: 180px;
    }

    .detail-preview img {
      width: 145px;
      height: 145px;
    }

    .detail-row {
      gap: 10px;
      font-size: 0.85rem;
    }
  }

  /* Refined detail-page navigation */
  .detail-breadcrumb {
    display: flex;
    align-items: center;
    margin: 0 0 22px;
    min-height: 38px;
  }

  .detail-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--blur-bg);
    color: var(--text-muted) !important;
    font-size: 0.84rem;
    font-weight: 550;
    text-decoration: none !important;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .detail-back-link svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  .detail-back-link:hover {
    color: var(--text-color) !important;
    background: var(--card-bg);
    border-color: var(--glass-border);
  }

  .detail-back-link:hover svg {
    transform: translateX(-2px);
  }

  @media (max-width: 560px) {
    .detail-breadcrumb {
      margin-bottom: 16px;
    }
  }

</style>
