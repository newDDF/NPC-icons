---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

const dataPath = path.join(process.cwd(), "public/data/icon-details.json");

export function getStaticPaths() {
  const dataPath = path.join(process.cwd(), "public/data/icon-details.json");
  const icons = JSON.parse(fs.readFileSync(dataPath, "utf8"));
  const seenRoutes = new Set();

  return icons.flatMap((icon) => {
    const legacyIds = Array.isArray(icon.legacyIds)
      ? icon.legacyIds
      : (icon.legacyId ? [icon.legacyId] : []);
    const paths = [];

    for (const routeId of [icon.id, ...legacyIds]) {
      if (!routeId || seenRoutes.has(routeId)) continue;
      seenRoutes.add(routeId);
      paths.push({ params: { id: routeId }, props: { icon } });
    }

    return paths;
  });
}

const { icon } = Astro.props;
const canonical = `https://icons.x0u0x.xyz/icons/${encodeURIComponent(icon.id)}/`;
const isRetired = icon.status === "retired";
const title = isRetired
  ? `${icon.name} Icon — Retired | NPC-icons`
  : `${icon.name} Icon — Free ${icon.format.toUpperCase()} Download | NPC-icons`;
const description = isRetired
  ? `The ${icon.name} icon has been retired and is no longer available for download.`
  : `Explore the ${icon.name} icon. View its details, categories and source, and download the free ${icon.format.toUpperCase()} asset from NPC-icons.`;
const stats = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/data/stats.json"), "utf8"));
const displayColor = icon.color && icon.color !== "none" ? icon.color : "";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  includeMainScript={false}
>
  <div class="detail-site-shell">
    <Header svgTotal={stats.svg} pngTotal={stats.png} />
    <main class="icon-detail-page">
      <article class="detail-workspace">
        <section class="workspace-preview-panel" aria-label="Icon preview">
          <nav class="workspace-tabs" aria-label="Icon workspace navigation">
            <a class="workspace-tab workspace-library-link" href="/" aria-label="Back to icon library">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 18-6-6 6-6"></path><path d="M8 12h12"></path></svg>
              <span>Back</span>
            </a>
            <button type="button" class="workspace-tab" data-workspace-tab="details" aria-pressed="false">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
              <span>Details</span>
            </button>
            <button type="button" class="workspace-tab is-active" data-workspace-tab="customize" aria-pressed="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h9"></path><path d="M17 7h3"></path><path d="M4 17h3"></path><path d="M11 17h9"></path><path d="M13 4v6"></path><path d="M7 14v6"></path></svg>
              <span>Customize</span>
            </button>
          </nav>

          <div class="detail-preview">
            {isRetired ? (
              <p role="status">
                This icon has been retired and is no longer available for download.
              </p>
            ) : (
              <img src={icon.path} alt={`${icon.name} icon`} width="180" height="180" />
            )}
          </div>

          <h1>{icon.name}</h1>
          <p class="detail-subtitle">Preview your icon and explore its details.</p>

          {icon.category?.length > 0 && (
            <div class="detail-categories">
              {icon.category.map((category) => <span class="detail-category">{category}</span>)}
            </div>
          )}

          <div class="workspace-preview-note">
            <span class="workspace-status-dot"></span>
            <span>Original asset preview</span>
          </div>
        </section>

        <section class="workspace-editor-panel" aria-label="Icon details and customization">



          {!isRetired && (
            <div
              class="workspace-section editor-controls"
              data-workspace-view="customize"
              data-icon-path={icon.path}
              data-icon-name={icon.name}
              data-icon-filename={icon.filename}
              data-icon-format={icon.format.toLowerCase()}
              data-icon-color={displayColor || ""}
            >
              <h3>Appearance</h3>

              <div class="editor-control-group">
                <div class="editor-control-label">
                  <label for="editor-size">Preview size</label>
                  <output for="editor-size" data-size-output>180 px</output>
                </div>
                <input id="editor-size" data-editor-control="size" type="range" min="64" max="320" step="8" value="180" />
              </div>

              <div class="editor-control-group">
                <span class="editor-control-title">Preview background</span>
                <div class="editor-choice-row" role="group" aria-label="Preview background">
                  <button type="button" class="editor-choice is-active" data-editor-bg="transparent" aria-pressed="true">Transparent</button>
                  <button type="button" class="editor-choice" data-editor-bg="light" aria-pressed="false">Light</button>
                  <button type="button" class="editor-choice" data-editor-bg="dark" aria-pressed="false">Dark</button>
                </div>
              </div>

              {icon.format.toLowerCase() === "svg" && (
                <div class="editor-control-group">
                  <div class="editor-palette" data-editor-palette aria-label="SVG color palette"></div>
                  <p class="editor-help" data-editor-palette-status>Analyzing SVG colors…</p>
                </div>
              )}
            </div>
          )}

          <div class="workspace-section" data-workspace-view="details">
            <h3>Icon information</h3>
            <div class="detail-information">
              <div class="detail-row">
                <span>Format</span>
                <strong>{icon.format.toUpperCase()}</strong>
              </div>

              {displayColor && (
                <div class="detail-row">
                  <span>Original color</span>
                  <strong class="detail-color">
                    <span class="detail-color-swatch" style={`background:${displayColor}`}></span>
                    {displayColor}
                  </strong>
                </div>
              )}

              <div class="detail-row">
                <span>Filename</span>
                <strong>{icon.filename}</strong>
              </div>

              <div class="detail-description">
                <h3>About this icon</h3>
                <p>{icon.info || "No additional information is available."}</p>
              </div>

              <div class="detail-row">
                <span>By</span>
                <strong>{icon.by || "Not provided"}</strong>
              </div>

              <div class="detail-row">
                <span>Origin</span>
                <strong>{({
                  official: "Official",
                  repository: "Icon repository",
                  traced: "Traced",
                  original: "Original",
                  other: "Other"
                })[icon.origin] || "Not provided"}</strong>
              </div>

              <div class="detail-row">
                <span>Source</span>
                {icon.source ? (
                  <a href={icon.source} target="_blank" rel="noopener noreferrer">Official Website ↗</a>
                ) : (
                  <span class="detail-muted">Not provided</span>
                )}
              </div>
            </div>
          </div>

          <div class="workspace-section workspace-export-section" data-workspace-view="customize">
            <h3>Export</h3>
            {!isRetired && (
              <div class="editor-export-settings">
                <span class="editor-control-title">Scale</span>
                <div class="editor-export-scales" role="group" aria-label="Export scale">
                  <button type="button" class="editor-export-scale is-active" data-export-scale="1" aria-pressed="true">1×</button>
                  <button type="button" class="editor-export-scale" data-export-scale="2" aria-pressed="false">2×</button>
                  <button type="button" class="editor-export-scale" data-export-scale="4" aria-pressed="false">4×</button>
                  <button type="button" class="editor-export-scale" data-export-scale="8" aria-pressed="false">8×</button>
                  <button type="button" class="editor-export-scale" data-export-scale="custom" aria-pressed="false">Custom</button>
                </div>
                <div class="editor-export-custom" data-export-custom hidden>
                  <div class="editor-control-group">
                    <label for="editor-export-width">Width (px)</label>
                    <input id="editor-export-width" data-export-width type="number" min="16" max="4096" step="1" value="512" inputmode="numeric" />
                  </div>
                  <div class="editor-control-group">
                    <label for="editor-export-height">Height (px)</label>
                    <input id="editor-export-height" data-export-height type="number" min="16" max="4096" step="1" value="512" inputmode="numeric" />
                  </div>
                </div>
              </div>
            )}
            {!isRetired && (
              <div class="detail-actions editor-export-actions">
                <a class="detail-primary" href={icon.path} download={icon.filename}>Original {icon.format.toUpperCase()}</a>
                <button type="button" class="detail-secondary" data-editor-export="png">Export PNG</button>
                <button type="button" class="detail-secondary" data-editor-export="webp">Export WebP</button>
                {icon.format.toLowerCase() === "svg" && (
                  <button type="button" class="detail-secondary" data-editor-export="svg">Customized SVG</button>
                )}
              </div>
            )}
            <p class="editor-status" data-editor-status role="status" aria-live="polite"></p>
          </div>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  .icon-detail-page {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
    padding: 18px 0 36px;
    color: var(--text-color);
  }

  .detail-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    gap: 20px;
  }

  .workspace-preview-panel,
  .workspace-editor-panel {
    min-width: 0;
    padding: clamp(22px, 3vw, 36px);
    border: 1px solid var(--glass-border);
    border-radius: 28px;
    background: var(--blur-bg);
    -webkit-backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur-strong)) saturate(var(--glass-saturate));
    box-shadow: var(--shadow);
  }

  .workspace-preview-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    zoom: 0.8;
  }

  .workspace-panel-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
  }

  .workspace-eyebrow {
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .workspace-format {
    padding: 6px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .detail-preview {
    display: grid;
    place-items: center;
    width: min(100%, 380px);
    aspect-ratio: 1;
    margin: auto 0 28px;
    border: 1px solid var(--glass-border);
    border-radius: 26px;
    background-color: var(--card-bg);
    background-image:
      linear-gradient(45deg, color-mix(in srgb, var(--text-muted) 7%, transparent) 25%, transparent 25%),
      linear-gradient(-45deg, color-mix(in srgb, var(--text-muted) 7%, transparent) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--text-muted) 7%, transparent) 75%),
      linear-gradient(-45deg, transparent 75%, color-mix(in srgb, var(--text-muted) 7%, transparent) 75%);
    background-size: 24px 24px;
    background-position: 0 0, 0 12px, 12px -12px, -12px 0;
  }

  .detail-preview img {
    display: block;
    width: 58%;
    height: 58%;
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
  }

  .workspace-preview-panel h1 {
    max-width: 100%;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  .detail-subtitle {
    margin: 10px 0 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .detail-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 22px;
  }

  .detail-category {
    padding: 5px 11px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--text-color);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .workspace-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: 6px;
    margin: 0 0 16px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .workspace-tab {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    background: var(--blur-bg);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .workspace-tab svg {
    width: 15px;
    height: 15px;
    flex: 0 0 auto;
  }

  .workspace-tab span {
    min-width: 0;
  }

  .workspace-tab:hover {
    border-color: var(--accent-color);
    color: var(--text-color);
  }

  .workspace-tab.is-active {
    border-color: var(--accent-color);
    background: var(--accent-color);
    color: #fff;
  }

  [data-workspace-view][hidden] {
    display: none !important;
  }

  .workspace-preview-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .workspace-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-color);
  }

  .workspace-editor-panel {
    text-align: left;
  }

  .workspace-editor-intro {
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* Appearance editor */
  .editor-controls {
    display: grid;
    gap: 12px;
  }

  .editor-controls > h3 {
    margin: 0 0 2px;
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .editor-control-group {
    display: grid;
    gap: 7px;
    min-width: 0;
  }

  .editor-control-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .editor-control-label output {
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .editor-control-title {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .editor-controls input[type="range"] {
    display: block;
    width: 100%;
    min-width: 0;
    margin: 0;
    accent-color: var(--accent-color);
    cursor: pointer;
  }

  /* Background selector */
  .editor-choice-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .editor-choice {
    display: inline-flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 8px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: #fff;
    color: #222;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .editor-choice:hover,
  .editor-choice:focus-visible {
    border-color: var(--accent-color);
    color: #222;
  }

  .editor-choice.is-active {
    border-color: var(--accent-color);
    background: var(--accent-color);
    color: #fff;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.35);
  }

  /* Keep export buttons consistent with their existing appearance */
  .detail-secondary {
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--card-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  .detail-secondary:hover {
    border-color: var(--accent-color);
  }

  /* Unified SVG color controls — no nested outer card */
  .editor-control-group:has([data-editor-palette]) {
    gap: 13px;
    padding-top: 22px;
    border-top: 1px solid var(--glass-border);
  }

  .editor-control-group:has([data-editor-palette]) > .editor-control-label {
    align-items: center;
  }

  .editor-color-row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .editor-color-row input[type="color"] {
    display: block;
    width: 48px;
    height: 44px;
    padding: 4px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--card-bg);
    cursor: pointer;
  }

  .editor-color-row input[type="text"] {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 13px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: var(--blur-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  .editor-text-button {
    padding: 5px 0 5px 10px;
    border: 0;
    background: transparent;
    color: var(--accent-color);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .editor-text-button:hover {
    opacity: 0.75;
  }

  .editor-help,
  .editor-status {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .editor-status:not(:empty) {
    margin-top: 12px;
  }

  /* Compact SVG color palette */
  .editor-palette {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  :global(.editor-palette-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28px, 1fr));
    gap: 8px;
    max-height: 144px;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 3px 5px 6px 2px;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--text-muted) 38%, transparent) transparent;
  }

  :global(.editor-palette-grid::-webkit-scrollbar) {
    width: 5px;
  }

  :global(.editor-palette-grid::-webkit-scrollbar-track) {
    background: transparent;
  }

  :global(.editor-palette-grid::-webkit-scrollbar-thumb) {
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-muted) 34%, transparent);
  }

  :global(.editor-palette-grid::-webkit-scrollbar-thumb:hover) {
    background: color-mix(in srgb, var(--accent-color) 62%, transparent);
  }

  :global(.editor-palette-swatch) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: var(--blur-bg);
    cursor: pointer;
    transition: transform 160ms ease, border-color 160ms ease;
  }

  :global(.editor-palette-swatch span) {
    display: block;
    width: 23px;
    height: 23px;
    border: 1px solid rgb(127 127 127 / 18%);
    border-radius: 50%;
  }

  :global(.editor-palette-swatch:hover) {
    transform: scale(1.08);
  }

  :global(.editor-palette-swatch[aria-pressed="true"]) {
    border: 2px solid var(--accent-color);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent-color) 13%, transparent);
  }

  :global(.editor-palette-editor) {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 10px;
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--blur-bg) 88%, transparent);
    backdrop-filter: blur(12px) saturate(125%);
    -webkit-backdrop-filter: blur(12px) saturate(125%);
  }

  :global(.editor-palette-editor[hidden]) {
    display: none !important;
  }

  :global(.editor-palette-editor input[type="color"]) {
    width: 34px;
    height: 34px;
    padding: 2px;
    border: 1px solid var(--glass-border);
    border-radius: 11px;
    background: var(--card-bg);
    cursor: pointer;
  }

  :global(.editor-palette-hex) {
    width: 100%;
    min-width: 0;
    height: 34px;
    padding: 0 9px;
    border: 1px solid var(--glass-border);
    border-radius: 9px;
    background: var(--card-bg);
    color: var(--text-color);
    font: inherit;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
  }

  :global(.editor-palette-opacity) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 10px;
    padding-top: 9px;
    border-top: 1px solid var(--glass-border);
  }

  :global(.editor-palette-opacity label) {
    color: var(--text-muted);
    font-size: 0.76rem;
  }

  :global(.editor-palette-opacity output) {
    color: var(--text-color);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  :global(.editor-palette-opacity input[type="range"]) {
    grid-column: 1 / -1;
    width: 100%;
    height: 18px;
    margin: 0;
    accent-color: var(--accent-color);
    cursor: pointer;
  }

  [data-editor-palette-status] {
    padding-top: 0;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  @media (max-width: 560px) {
    .editor-controls {
      gap: 22px;
    }

    .editor-choice-row {
      gap: 6px;
    }

    .editor-choice {
      min-height: 40px;
      padding: 7px 5px;
