---
import fs from "node:fs";
import path from "node:path";

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Toolbar from "../components/Toolbar.astro";
import IconGrid from "../components/IconGrid.astro";
import IconModal from "../components/IconModal.astro";
import ShareMenu from "../components/ShareMenu.astro";
import Footer from "../components/Footer.astro";

const stats = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/data/stats.json"), "utf8"));
const svgTotal = stats.svg;
const pngTotal = stats.png;
---

<BaseLayout>
<div class="top-shell">
  <Header svgTotal={svgTotal} pngTotal={pngTotal} />

  <Toolbar />

  <IconGrid />

  <IconModal />

  <div class="toast" id="toast">Copied to clipboard!</div>

  <ShareMenu />

  <Footer />
</div>
</BaseLayout>
