---
import "../styles/global.css";

const { title = "NPC-icons", lang = "zh-CN", theme = "light" } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} data-theme={theme}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" href="https://newddf.xyz/favicon.ico" type="image/x-icon">
</head>
<body>
  <slot />
  <script src="/assets/js/main.js" is:inline></script>
</body>
</html>
